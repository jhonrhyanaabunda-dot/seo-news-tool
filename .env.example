# ─────────────────────────────────────────────────────────────────────────────
# A3 SEO & News Monitoring Tool — environment configuration
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Any managed Postgres works: Neon, Supabase, Vercel Postgres, RDS, Railway…
# Use the *pooled* connection string for serverless (Neon "-pooler" host,
# Supabase "Transaction" pooler on port 6543, etc.).
DATABASE_URL=postgres://user:password@host:5432/a3_seo_monitor?sslmode=require
# Optional: direct (non-pooled) URL used only by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Application ──────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used in email links). No trailing slash.
APP_URL=https://seo.example.com
# Random 32+ char secret used to sign/verify session cookies. `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# IANA timezone used for scheduling digests and displaying times.
APP_TIMEZONE=America/Chicago

# ── Cron / worker security ───────────────────────────────────────────────────
# Shared secret required by /api/cron/* endpoints. Vercel Cron sends it
# automatically as "Authorization: Bearer <CRON_SECRET>". External schedulers
# (GitHub Actions, cron-job.org, the standalone worker) must send the same header.
CRON_SECRET=change-me-to-a-long-random-string
# Max seconds a single cron tick may spend processing jobs (keep below the
# function maxDuration; Vercel Fluid Compute allows up to 300s on Hobby, 800s on Pro).
CRON_TICK_BUDGET_SECONDS=240

# ── Email ────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER: "resend" (recommended on Vercel), "smtp", or "console" (dev only, logs emails)
EMAIL_PROVIDER=console
# Must be an address on a domain verified in Resend (Resend → Domains), e.g. reports@yourdomain.com.
# For a first test before the domain is verified, "A3 SEO Monitor <onboarding@resend.dev>" works,
# but Resend then only delivers to the email address that owns the Resend account.
EMAIL_FROM="A3 SEO Monitor <seo-monitor@example.com>"
# Resend (https://resend.com) — API-based, works from serverless functions.
# Resend → API Keys → Create API key with "Sending access". Starts with re_. Never commit it.
RESEND_API_KEY=
# SMTP alternative (e.g. Gmail, Google Workspace, SES SMTP, Postmark SMTP)
# Gmail (free, no domain needed; about 500 recipients/day):
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=the Gmail address   EMAIL_FROM="A3 SEO Monitor <the same Gmail address>"
#   SMTP_PASS=a Google App Password (turn on 2-Step Verification, then
#   https://myaccount.google.com/apppasswords). The normal Gmail password does not work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── News sources ─────────────────────────────────────────────────────────────
# Built-in providers use public RSS feeds (Google News RSS, Bing News RSS) and
# need no keys. Optional API providers add coverage:
# NewsAPI.org (https://newsapi.org) — optional
NEWSAPI_KEY=
# GNews (https://gnews.io) — optional
GNEWS_API_KEY=
# Comma-separated list of enabled providers: google_rss,bing_rss,newsapi,gnews
NEWS_PROVIDERS=google_rss,bing_rss

# ── Crawler ──────────────────────────────────────────────────────────────────
# The crawler identifies itself honestly as a bot (like Googlebot). Leave empty for the
# default: "Mozilla/5.0 (compatible; A3SEOMonitor/1.0; +<APP_URL>/bot)". robots.txt rules
# for the "A3SEOMonitor" token are honoured. The monitor never tries to get around
# Cloudflare or other security controls; blocked pages are reported as "not evaluated".
CRAWLER_USER_AGENT=
# Crawls are sitemap-first: robots.txt → sitemap.xml / sitemap index → the site's own
# URLs (most important dealership pages first) → internal links only for any budget left.
#
# Each setting below has a friendly alias; set either name (the original wins if both are set):
#   CRAWLER_DEFAULT_MAX_PAGES  = MAX_PAGES_PER_DEALERSHIP   pages analysed per scan (a dealership can override it)
#   JOB_CONCURRENCY            = MAX_CONCURRENT_REQUESTS    jobs a worker runs at once; each site is still crawled one request at a time
#   CRAWLER_DELAY_MS           = REQUEST_DELAY              ms between requests to the same site (robots.txt Crawl-delay wins if longer)
#   CRAWLER_TIMEOUT_MS         = REQUEST_TIMEOUT            ms before a request times out
#   CRAWLER_MAX_RETRIES        = MAX_RETRIES                retries for timeouts/5xx only — refusals (401/403/429/challenges) are never retried
CRAWLER_DEFAULT_MAX_PAGES=40
CRAWLER_TIMEOUT_MS=15000
CRAWLER_DELAY_MS=750
CRAWLER_MAX_RETRIES=1

# ── Crawl-job API (machine-to-machine) ───────────────────────────────────────
# Bearer token for POST /api/crawl-jobs and GET /api/crawl-jobs/{id}. The API is
# disabled while this is empty. Generate: openssl rand -base64 32
CRAWLER_API_TOKEN=

# ── AI-assisted SEO reports (Claude) ─────────────────────────────────────────
# Reports are built from stored crawler findings by code. The AI only writes the
# executive summary and prioritises recommended actions, and anything it returns
# that does not match the findings is discarded. Without a key, reports are still
# generated deterministically from the same findings.
ANTHROPIC_API_KEY=
AI_REPORT_MODEL=claude-opus-5
# low | medium | high | xhigh | max — summarising verified findings does not need the deepest reasoning.
AI_REPORT_EFFORT=medium
# Hard ceiling on model calls per UTC calendar month. Reports whose findings have
# not changed reuse the stored summary and do not count.
AI_REPORTS_MONTHLY_LIMIT=300

# Optional: Google PageSpeed Insights API key for real Lighthouse performance
# metrics (LCP/CLS/TBT) on each dealership homepage. Displayed for context; not
# part of the deterministic score. https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# When a site restricts the crawler, use Google PageSpeed Insights (a public Google API)
# as a clearly-labelled alternative source for a limited homepage check. Needs
# PAGESPEED_API_KEY. Set to false to disable.
REMOTE_AUDIT_FALLBACK=true

# ── Real-browser rendering (Chromium via Playwright) ─────────────────────────
# Some websites only serve HTML to a client that runs JavaScript. A real browser
# does that. This is NOT a bypass of their security: the crawler keeps its honest
# "A3SEOMonitor" User-Agent, still honours robots.txt, and uses no stealth or
# fingerprint-spoofing. If the site still refuses, the refusal is reported as before.
#   off      = plain HTTP only (default; the only option that works on Vercel)
#   fallback = use Chromium only when a page is refused or challenged (recommended)
#   always   = render every page with Chromium (slower; for JavaScript-only sites)
# Chromium cannot run on Vercel functions — set this on the worker (worker/Dockerfile
# ships a browser) or locally after `npx playwright install chromium`.
BROWSER_RENDERING=off
# Use an already-installed browser instead of Playwright's Chromium, e.g. "chrome".
BROWSER_CHANNEL=
# Explicit Chromium binary path (overrides BROWSER_CHANNEL).
BROWSER_EXECUTABLE_PATH=
BROWSER_TIMEOUT_MS=45000
# How long a JavaScript challenge may take before the refusal is reported.
BROWSER_CHALLENGE_WAIT_MS=12000
# Longest wait for a rendered page to finish loading and stop changing before it is read.
# Dealer sites build headings and text with JavaScript; reading too early gives scores that vary scan to scan.
BROWSER_SETTLE_MS=8000
# Close the shared browser after this long with no page fetches (0 = keep open).
BROWSER_IDLE_TIMEOUT_MS=60000
# Set true only when Chromium must run as root in a container (the supplied
# worker image runs as an unprivileged user, so leave this off).
BROWSER_NO_SANDBOX=false
# Browser pages open at once in this process. A page costs far more memory than
# an HTTP request, so this is capped separately from JOB_CONCURRENCY — otherwise
# several parallel scans each drive a browser and the worker runs out of memory.
BROWSER_MAX_CONCURRENCY=2
# Per-host sessions (cookie jars) kept alive at once. Each site's session is
# reused across its crawl; the least recently used idle one is closed beyond this.
BROWSER_MAX_CONTEXTS=4

# ── Crawler regions ──────────────────────────────────────────────────────────
# Where SEO scans run:
#   worker = only dedicated U.S. crawler workers crawl (recommended for production:
#            Vercel functions never crawl, and protected sites get a real browser)
#   vercel = Vercel Cron ticks also crawl, plain HTTP only, from iad1 (fallback when
#            no worker is deployed; sites that need a browser will show as protected)
CRAWLER_MODE=vercel
# Region for dealerships without a "Preferred crawler region".
DEFAULT_CRAWLER_REGION=us-east
# Optional extra regions (US-East/Central/West are built in): "eu-west:EU-West,ca-central:Canada"
CRAWLER_EXTRA_REGIONS=

# ── Job processing ───────────────────────────────────────────────────────────
# How many jobs (e.g. dealership scans) one cron tick processes in parallel.
# Each scan crawls a different website, so this is network-bound, not CPU-bound.
JOB_CONCURRENCY=4

# ── Crawler worker (worker/ — runs on Fly.io, Railway, Render… in a US region) ─
# Region this worker crawls for: us-east | us-central | us-west | <extra region id>
# WORKER_REGION=us-east
# Job types it runs (default: all). A crawl-only regional worker: WORKER_JOB_TYPES=seo_scan
# WORKER_JOB_TYPES=
# How often an idle worker checks for new jobs (a manual "Scan now" starts within this).
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_ID=crawler-us-east-1
# Set false to silence the "[Crawler] …" progress lines in worker logs.
# CRAWLER_LOGS=true
