{
  "name": "a3-seo-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "user:create": "NODE_OPTIONS=--conditions=react-server tsx scripts/create-admin.ts",
    "scan:once": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-tick.ts",
    "news:rescore": "NODE_OPTIONS=--conditions=react-server tsx scripts/rescore-news.ts",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx worker/index.ts",
    "crawler": "NODE_OPTIONS=--conditions=react-server tsx worker/index.ts",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test tests/*.test.ts",
    "vercel-build": "npm run db:migrate && next build",
    "news:enrich": "NODE_OPTIONS=--conditions=react-server tsx scripts/enrich-news.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "playwright-core": "^1.63.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.0",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=20.9"
  }
}
